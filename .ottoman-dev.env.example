# Copy to .ottoman-dev.env (gitignored) and fill in. Sourced by scripts/dev-env.sh.
DEV_USER=dev                                  # login user baked into DEV=1 images and dev ISOs (sudo without password)
DEV_REGISTRY_HOST=192.0.2.10                  # this machine's LAN address: the dev registry on :18821 and the VM/Tiny pull from it
DEV_SSH_IDENTITY=$HOME/.ssh/id_ed25519_ottoman   # key the dev scripts use to reach test boxes; its .pub goes into dev images
