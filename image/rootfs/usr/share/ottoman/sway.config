# Ottoman session compositor: sway in kiosk configuration (M2.0, 2026-11-03).
# Why sway and not cage: Home must bring the launcher forward over a running app and Back must still
# reach the app. cage only shows the newest toplevel; sway exposes focus/kill/scratchpad over IPC.
xwayland disable
default_border none
default_floating_border none
focus_follows_mouse no
mouse_warping none
seat * hide_cursor 3000
output * bg #000000 solid_color
# Every app window is fullscreen; the launcher (app_id ottoman-shell) too. Stacking is driven over IPC.
for_window [app_id=".*"] fullscreen enable, border none
for_window [app_id="ottoman-shell"] fullscreen enable
# No bar, no keybindings except a dev escape hatch to a terminal (removed before a release).
bindsym Mod4+Return exec foot
bindsym Mod4+Shift+q kill
exec /usr/libexec/ottoman/session.sh
