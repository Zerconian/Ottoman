# Ottoman OS image, milestone M1: boots to a Wayland kiosk running Jellyfin Media Player.
# Base follows the build host's Fedora release (44 at the time of writing). Bump deliberately, never "latest".
# Stage 1: compile the launcher (ottoman-shell) with the same Fedora release's Qt.
FROM quay.io/fedora/fedora:44 AS shell-build
RUN dnf -y install cmake ninja-build gcc-c++ qt6-qtbase-devel qt6-qtdeclarative-devel qt6-qtwayland-devel && dnf clean all
COPY shell/ /src/
RUN cmake -S /src -B /out -G Ninja -DCMAKE_BUILD_TYPE=Release && cmake --build /out

# Stage 2: the OS image.
FROM quay.io/fedora/fedora-bootc:44
# DEV=1 (scripts/build-image.sh default) marks the build host's dev registry insecure so dev installs can pull updates.
# It lives in /etc inside the image, so every dev image carries it across upgrades and a release image drops it.
ARG DEV=0
# Links the ghcr package to the repository on push (permissions and visibility then follow the repo), and names the source.
LABEL org.opencontainers.image.source="https://github.com/Zerconian/Ottoman" org.opencontainers.image.description="Ottoman: a minimal remote-first TV OS for leftover x86 mini PCs" org.opencontainers.image.licenses="MIT"
ARG DEV_USER=dev
# dev builds: insecure registries the test boxes may pull from (QEMU user-net gateway + the build host's LAN address)
ARG DEV_REGISTRIES="10.0.2.2:18821"
ARG GIT_SHA=unknown

# RPM Fusion: Fedora proper ships no Intel VA-API drivers and strips H.264/HEVC from mesa's VA-API.
# i965 (libva-intel-driver) is in rpmfusion-free, iHD (intel-media-driver) in rpmfusion-nonfree,
# mesa-va-drivers-freeworld (AMD/Intel codecs re-enabled) in rpmfusion-free.
# (First build 2026-11-02 failed with "No match for argument: libva-intel-driver": the host's
#  dnf repoquery saw them only because the build host has RPM Fusion enabled.)
RUN dnf -y install \
      https://mirrors.rpmfusion.org/free/fedora/rpmfusion-free-release-$(rpm -E %fedora).noarch.rpm \
      https://mirrors.rpmfusion.org/nonfree/fedora/rpmfusion-nonfree-release-$(rpm -E %fedora).noarch.rpm \
    && dnf -y swap mesa-va-drivers mesa-va-drivers-freeworld

# Graphics + media: both Intel VA-API drivers on purpose. iHD (intel-media-driver) is Broadwell+;
# the floor-tier Haswell box (HD 4400) needs the legacy i965 driver (libva-intel-driver).
RUN dnf -y install \
      sway swayidle foot \
      qt6-qtdeclarative qt6-qtwayland qt6-qtsvg \
      mesa-dri-drivers mesa-vulkan-drivers libva-intel-driver intel-media-driver libva-utils \
      pipewire pipewire-alsa pipewire-pulseaudio wireplumber \
      NetworkManager NetworkManager-wifi \
      flatpak xdg-desktop-portal xdg-desktop-portal-gtk xdg-desktop-portal-wlr sudo \
      dejavu-sans-fonts glibc-langpack-en \
      polkit dbus-daemon \
      python3-evdev \
      greenboot greenboot-default-health-checks \
      plymouth plymouth-theme-spinner plymouth-system-theme \
    && dnf clean all \
    && rm -rf /var/cache /var/log/dnf* /var/lib/dnf /run/dnf /run/selinux-policy /tmp/* \
    && rm -rf /var/lib/AccountsService /var/lib/flatpak /var/lib/geoclue

COPY image/rootfs/ /
COPY --from=shell-build /out/ottoman-shell /usr/libexec/ottoman/ottoman-shell
COPY inputd/ottoman-inputd.py /usr/libexec/ottoman/ottoman-inputd
RUN chmod 0755 /usr/libexec/ottoman/*.sh /usr/libexec/ottoman/ottoman-shell && chmod 0440 /etc/sudoers.d/ottoman && visudo -cf /etc/sudoers.d/ottoman \
    && chmod 0755 /usr/libexec/ottoman/ottoman-inputd && chmod 0755 /etc/greenboot/check/required.d/*.sh && systemctl enable ottoman-session.service ottoman-inputd.service greenboot-healthcheck.service greenboot-set-rollback-trigger.service \
    && systemctl disable NetworkManager-wait-online.service \
    && systemctl set-default multi-user.target

# Quiet boot (zerc, 2026-11-03): grub menu hidden (Shift shows it), Plymouth spinner from the initramfs until sway's
# first frame. The initramfs is regenerated so plymouth is inside it; grub's static config comes from bootupd at install.
# Branding: boot entries and About read "Ottoman" (ID=fedora stays: packaging depends on it). The Plymouth
# watermark is replaced by image/rootfs' wordmark (copied before this step).
RUN sed -i 's/^NAME=.*/NAME="Ottoman"/; s/^PRETTY_NAME=.*/PRETTY_NAME="Ottoman"/; s/^VARIANT=.*/VARIANT="TV"/; s/^VARIANT_ID=.*/VARIANT_ID=tv/' /usr/lib/os-release \
    && grep -q 'PRETTY_NAME="Ottoman"' /usr/lib/os-release
RUN sed -i 's/^set timeout_style=menu$/set timeout_style=hidden/; s/^set timeout=1$/set timeout=0/' /usr/lib/bootupd/grub2-static/grub-static-pre.cfg \
    && grep -q "timeout_style=hidden" /usr/lib/bootupd/grub2-static/grub-static-pre.cfg \
    && plymouth-set-default-theme spinner \
    && KVER=$(ls /usr/lib/modules | head -1) \
    && dracut --no-hostonly --kver "$KVER" --reproducible --zstd --add "ostree plymouth" \
         --omit "clevis clevis-pin-file clevis-pin-null clevis-pin-sss clevis-pin-tang clevis-pin-tpm2 network-manager network net-lib nss-softokn fips fips-crypto-policies systemd-pcrphase modsign" \
         -f "/usr/lib/modules/$KVER/initramfs.img" 2>&1 | tail -2 \
    && ls -la "/usr/lib/modules/$KVER/initramfs.img" \
    && lsinitrd "/usr/lib/modules/$KVER/initramfs.img" | grep -q plymouthd
RUN if [ "$DEV" = 1 ]; then mkdir -p /etc/containers/registries.conf.d \
    && { echo '# dev builds only: the build host dev registry, reachable from QEMU user networking and the LAN'; \
         for r in $DEV_REGISTRIES; do printf '[[registry]]\nlocation = "%s"\ninsecure = true\n' "$r"; done; } \
      > /etc/containers/registries.conf.d/50-ottoman-dev.conf \
    && printf '%s ALL=(ALL) NOPASSWD: ALL\n' "$DEV_USER" > /etc/sudoers.d/50-ottoman-dev && chmod 0440 /etc/sudoers.d/50-ottoman-dev; fi
# (the dev login user itself comes from bib: image/bib-config.dev*.toml; bib's ISO path ignores customizations.files AND
#  installer.sudo-nopasswd, measured 2026-11-03, so the sudo rule lives in the DEV image too)
# Build identity for About and for update checks: every build differs, so every push is a real update.
RUN mkdir -p /usr/share/ottoman && printf 'commit=%s\nbuilt=%s\n' "$GIT_SHA" "$(date -u +%Y-%m-%dT%H:%MZ)" > /usr/share/ottoman/build-info
# Boot never waits on the network (zerc, 2026-11-03): NetworkManager-wait-online is off; nothing of ours is ordered
# after network-online.target, and every wait Ottoman adds (first-boot Flatpak install 60 s, greenboot check 90 s) is bounded.
# bootc's own lint: no content in /var, no world-writable surprises.
RUN bootc container lint
