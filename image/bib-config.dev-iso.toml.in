# bootc-image-builder customizations for the DEV installer ISO (TYPE=anaconda-iso). The ISO path ignores
# customizations.files AND installer.sudo-nopasswd (both measured 2026-11-03: no NOPASSWD anywhere in the manifest,
# sudo asked for a password on the installed box), so the sudo rule is baked into DEV=1 images instead.
# Never ship an ISO built with this.
[[customizations.user]]
name = "@DEV_USER@"
groups = ["wheel"]
key = "@DEV_SSH_KEY@"

[customizations.installer]
unattended = true
